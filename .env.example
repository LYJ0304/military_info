# Auth.js / NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret

# Kakao Developers > 내 애플리케이션 > 앱 키 / 보안
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# PostgreSQL (use a pooled URL for Neon in Vercel)
DATABASE_URL=

# CSV import (server-only: do not prefix with NEXT_PUBLIC_)
CSV_DOWNLOAD_URL=https://opendata.mnd.go.kr/openinf/opencom/down2csv.jsp
CRON_SECRET=replace-with-a-long-random-secret

# GitHub Actions -> Notion meal synchronization
NOTION_API_KEY=
NOTION_DATABASE_ID=
# Optional: takes precedence over NOTION_DATABASE_ID.
NOTION_DATA_SOURCE_ID=
SYNC_PAST_DAYS=14
SYNC_FUTURE_DAYS=14
